<?xml version="1.0" encoding="ISO-8859-1"?>
<pipelineDSL:Pipeline xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:pipelineDSL="http://www.esi.uclm/alarcos/greenteam/pipeline/PipelineDSL" jobOrStageVar="stages:">
  <pipelineConfiguration name="Refactor"/>
  <triggers name="push:"/>
  <stages name="refactorstage">
    <jobs name="refactorjob">
      <jobParameterValues name="pool:">
        <subParameters name="name:" value="&quot;MyAgent&quot;"/>
      </jobParameterValues>
      <steps xsi:type="pipelineDSL:Script" name="script:" command="~/runner-config/scripts/refactor.sh greencoderefactor-python &quot;ExplicitRaiseToExceptBodyTransformer&quot;"/>
    </jobs>
  </stages>
</pipelineDSL:Pipeline>
