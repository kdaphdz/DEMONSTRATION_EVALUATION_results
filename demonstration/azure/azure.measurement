measurement:
    which:
      	approach: software
      		tool: perf
      		config:
        		events: power/energy-pkg/, power/energy-cores/
        		interval: 20
    how:
    	repetitions: 10
     	baseline: true
	what:
		stages:
			stage: "stage"
				jobs:
				    job: "build"
				    	steps: 5
