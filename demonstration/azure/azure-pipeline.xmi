<?xml version="1.0" encoding="ASCII"?>
<pipelineDSL:Pipeline xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:pipelineDSL="http://www.esi.uclm/alarcos/greenteam/pipeline/PipelineDSL" jobOrStageVar="stages:">
  <pipelineConfiguration name="Benchmark"/>
  <triggers name="push:"/>
  <stages name="stage" displayName="Benchmark Stage">
    <jobs name="benchmark">
      <jobParameterValues name="pool:">
        <subParameters name="name:" value="&quot;MyAgent&quot;"/>
      </jobParameterValues>
      <steps xsi:type="pipelineDSL:Script" name="task:" command="CmdLine@2">
        <subSteps xsi:type="pipelineDSL:Action" actionKeyword="inputs:">
          <subSteps xsi:type="pipelineDSL:Script" name="script:" command="&quot;pip install --upgrade pip\npip install -r requirements.txt\n&quot;"/>
        </subSteps>
        <subSteps xsi:type="pipelineDSL:Action" actionKeyword="displayName:" actionValue="&quot;Upgrade pip and install dependencies&quot;"/>
      </steps>
      <steps xsi:type="pipelineDSL:Script" name="task:" command="CmdLine@2">
        <subSteps xsi:type="pipelineDSL:Action" actionKeyword="inputs:">
          <subSteps xsi:type="pipelineDSL:Script" name="script:" command="&quot;pytest --benchmark-only --benchmark-save=benchmark_run&quot;"/>
        </subSteps>
        <subSteps xsi:type="pipelineDSL:Action" actionKeyword="displayName:" actionValue="&quot;Run benchmark tests&quot;"/>
      </steps>
    </jobs>
  </stages>
</pipelineDSL:Pipeline>
