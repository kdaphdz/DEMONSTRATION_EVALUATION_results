<?xml version="1.0" encoding="ASCII"?>
<measurementDSL:Measurement xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:measurementDSL="http://www.esi.uclm/alarcos/greenteam/measurement/MeasurementDSL" platform="Azure">
  <which>
    <approach xsi:type="measurementDSL:SoftwareApproach">
      <tool xsi:type="measurementDSL:PerfTool">
        <config interval="20">
          <events>power/energy-pkg/</events>
          <events>power/energy-cores/</events>
        </config>
      </tool>
    </approach>
  </which>
  <how repetitions="10" baseline="true"/>
  <what>
    <stages name="stage">
      <jobs name="benchmark">
        <steps>2</steps>
      </jobs>
    </stages>
  </what>
</measurementDSL:Measurement>