    xmlns:pipelineDSL="http://www.esi.uclm/alarcos/greenteam/pipeline/PipelineDSL"
    jobOrStageVar="jobs:">

  <pipelineConfiguration name="Benchmark"/>
  <triggers name="push:"/>

  <jobs name="benchmark_9">
    <jobParameterValues name="runs-on:" value="self-hosted"/>
    <steps xsi:type="pipelineDSL:Action" actionKeyword="name:" actionValue="&quot;Checkout repository&quot;">
      <subSteps xsi:type="pipelineDSL:Action" actionKeyword="uses:" actionValue="actions/checkout@v3"/>
    </steps>
    <steps xsi:type="pipelineDSL:Action" actionKeyword="name:" actionValue="&quot;Upgrade pip and install dependencies&quot;">
      <subSteps xsi:type="pipelineDSL:Script" name="run:" command="&quot;pip install --upgrade pip&#10;pip install -r requirements.txt&#10;&quot;"/>
    </steps>
    <steps xsi:type="pipelineDSL:Script" name="run:" command="&quot;~/runner-config/scripts/setup.sh &amp;quot;start_measurement&amp;quot; &amp;quot;baseline=true&amp;quot; &amp;quot;benchmark_3&amp;quot; &amp;quot;software&amp;quot; perf &amp;quot;interval=10&amp;quot; &amp;quot;events=power/energy-pkg/,power/energy-cores/&amp;quot;&#10;&quot;"/>
    <steps xsi:type="pipelineDSL:Action" actionKeyword="name:" actionValue="&quot;Run benchmark tests&quot;">
      <subSteps xsi:type="pipelineDSL:Script" name="run:" command="&quot;pytest --benchmark-only --benchmark-save=benchmark_run&#10;&quot;"/>
    </steps>
    <steps xsi:type="pipelineDSL:Script" name="run:" command="&quot;~/runner-config/scripts/setup.sh &amp;quot;end_measurement&amp;quot; &amp;quot;benchmark_3&amp;quot;&#10;&quot;"/>
  </jobs>

